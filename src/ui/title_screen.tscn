[node name="Center" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Content" type="VBoxContainer" parent="Center"]
layout_mode = 2
theme_override_constants/separation = 18
alignment = 1

[node name="Title" type="Label" parent="Center/Content"]
layout_mode = 2
theme_override_colors/font_color = Color(0.96, 0.94, 0.86, 1)
theme_override_font_sizes/font_size = 54
text = "Nebezpečný úkol"
horizontal_alignment = 1

[node name="Subtitle" type="Label" parent="Center/Content"]
layout_mode = 2
theme_override_colors/font_color = Color(0.73, 0.78, 0.75, 1)
theme_override_font_sizes/font_size = 20
text = "Poznej assassiny podle portrétů a přežij do 19:00."
horizontal_alignment = 1

[node name="Spacer" type="Control" parent="Center/Content"]
custom_minimum_size = Vector2(0, 8)
layout_mode = 2

[node name="Start" type="Button" parent="Center/Content"]
custom_minimum_size = Vector2(260, 54)
layout_mode = 2
size_flags_horizontal = 4
theme_override_colors/font_color = Color(0.1, 0.12, 0.13, 1)
theme_override_colors/font_hover_color = Color(0.1, 0.12, 0.13, 1)
theme_override_colors/font_focus_color = Color(0.1, 0.12, 0.13, 1)
theme_override_font_sizes/font_size = 22
theme_override_styles/normal = SubResource("button_normal")
theme_override_styles/hover = SubResource("button_hover")
theme_override_styles/pressed = SubResource("button_hover")
text = "Hrát"

[node name="Actions" type="HBoxContainer" parent="Center/Content"]
layout_mode = 2
size_flags_horizontal = 4
theme_override_constants/separation = 12

[node name="HowTo" type="Button" parent="Center/Content/Actions"]
unique_name_in_owner = true
custom_minimum_size = Vector2(110, 36)
layout_mode = 2
toggle_mode = true
text = "Jak hrát"

[node name="Quit" type="Button" parent="Center/Content/Actions"]
custom_minimum_size = Vector2(110, 36)
layout_mode = 2
text = "Ukončit"

[node name="HowToContent" type="PanelContainer" parent="Center/Content"]
unique_name_in_owner = true
visible = false
custom_minimum_size = Vector2(580, 0)
layout_mode = 2
theme_override_styles/panel = SubResource("StyleBoxFlat_how_to")

[node name="Instructions" type="RichTextLabel" parent="Center/Content/HowToContent"]
layout_mode = 2
mouse_filter = 2
theme_override_colors/default_color = Color(0.85, 0.89, 0.87, 1)
theme_override_constants/line_separation = 6
bbcode_enabled = true
fit_content = true
scroll_active = false
text = "[b]A / D nebo šipky[/b] | Pohyb. Myší se rozhlížej a pohledem odraď útočníka.
[b]Tab[/b] | Porovnej portréty s tvářemi v davu.
[b]Drž levé tlačítko[/b] | Zblízka promluvíš nebo zaútočíš. Když se cíl otočí k tobě, pusť tlačítko.
[b]E u stojanu[/b] | Opři se a na chvíli se chraň před útokem.
[b]F[/b] | Odraz útok, když se čas zpomalí a objeví se výzva.
[b]Svědci[/b] | Blízcí civilisté po útoku utečou a mohou upozornit assassiny.
[b]Skóre[/b] | Assassin body přidá, civilista je ubere. Úkol je za bonus."

[connection signal="pressed" from="Center/Content/Start" to="." method="_on_start_pressed"]
[connection signal="toggled" from="Center/Content/Actions/HowTo" to="." method="_on_how_to_toggled"]
[connection signal="pressed" from="Center/Content/Actions/Quit" to="." method="_on_quit_pressed"]
